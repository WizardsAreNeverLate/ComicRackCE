<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- ComicRack already has its own assemblies. The output folder holds only what the plugin has to ship. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Outside this repository, reference ComicRack.Plugins.dll, ComicRack.Engine.dll and cYo.Common.Windows.dll from the ComicRack folder instead. -->
    <ProjectReference Include="..\..\ComicRack.Plugins\ComicRack.Plugins.csproj" Private="false" />
    <ProjectReference Include="..\..\ComicRack.Engine\ComicRack.Engine.csproj" Private="false" />
    <ProjectReference Include="..\..\cYo.Common.Windows\cYo.Common.Windows.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- ComicRack finds the image of a command in the DLL when the plugin folder has no file with that name. -->
    <EmbeddedResource Include="SamplePlugin.png" />
  </ItemGroup>
</Project>
