<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.81.10" />
    <!-- The tests compile their fixture plugins with Roslyn. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ComicRack.Plugins\ComicRack.Plugins.csproj" />
    <ProjectReference Include="..\ComicRack.Plugins.Compiler\ComicRack.Plugins.Compiler.csproj" />
    <ProjectReference Include="..\ComicRack.Engine\ComicRack.Engine.csproj" />
    <ProjectReference Include="..\cYo.Common.Windows\cYo.Common.Windows.csproj" />
    <ProjectReference Include="..\Samples\SamplePlugin\SamplePlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Samples\SampleLibrary\SampleLibrary.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- One test scans a script folder inside the built ComicRack folder, with ComicRack.exe.config. -->
    <ProjectReference Include="..\ComicRack\ComicRack.csproj" ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ComicRackFolder</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\ComicRack\bin\$(Configuration)\net48</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- The tests install the samples the way a user does: the built DLL of the compiled sample, the folder of the source sample. -->
  <Target Name="CopySamples" AfterTargets="Build">
    <ItemGroup>
      <SampleSourcePluginFile Include="..\Samples\SampleSourcePlugin\**" />
    </ItemGroup>
    <Copy SourceFiles="..\Samples\SamplePlugin\bin\$(Configuration)\net48\SamplePlugin.dll" DestinationFolder="$(OutDir)Samples\SamplePlugin" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SampleSourcePluginFile)" DestinationFolder="$(OutDir)Samples\SampleSourcePlugin\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
